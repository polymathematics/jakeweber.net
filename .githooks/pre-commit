#!/bin/sh
# Regenerates the two things in this repo that are built rather than written,
# so neither can ever fall out of sync with its source:
#
#   manifest.js   <- images/gallery/, books/, work/, journal/
#   essays/*.html <- essays/posts/*.md and essays/index.md
#
# Active because the repo sets core.hooksPath to .githooks. If you ever re-clone,
# run this once to turn it back on:  git config core.hooksPath .githooks

./make-manifest.sh >/dev/null || {
  echo "pre-commit: make-manifest.sh failed, commit aborted" >&2
  exit 1
}

git add manifest.js

./make-essays.py >/dev/null || {
  echo "pre-commit: make-essays.py failed, commit aborted" >&2
  exit 1
}

git add essays/*.html
